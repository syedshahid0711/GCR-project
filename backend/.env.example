# Flask
FLASK_ENV=development
SECRET_KEY=change-this-to-a-random-secret-key

# Database (SQLite - free, no setup needed)
DATABASE_URL=sqlite:///eduai.db

# Google OAuth 2.0 (FREE - get from console.cloud.google.com)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# Google Gemini AI (FREE - get from aistudio.google.com)
GEMINI_API_KEY=your-gemini-api-key

# Encryption key for storing OAuth tokens (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
FERNET_KEY=your-fernet-key

# Email Notifications (FREE - Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Telegram Bot (FREE - optional, get from @BotFather)
TELEGRAM_BOT_TOKEN=optional-telegram-bot-token

# Frontend URL
FRONTEND_URL=http://localhost:5173
